# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files that should always be normalized
*.py text
*.js text
*.jsx text
*.css text
*.html text
*.md text

# Declare files that will always have specific line endings
*.bat text eol=crlf
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Preserve pinned upstream HTML whitespace and license bytes exactly.
# These are wire/provenance fixtures, not source formatting candidates.
rust/crates/store/datasets/unified-html-source-1/** -text -whitespace

# Combined-statistics golden templates preserve exact pinned Django/DRF bytes.
rust/crates/app/datasets/combined-stats-html/*.html.in -text -whitespace

# Preserve verbatim upstream license/AUTHORS underlines in attribution.
ATTRIBUTION.md conflict-marker-size=32

# Preserve exact bytes of the historically executed Original-side HTTP oracle.
scripts/rust-contracts/executable-fixtures/image240-original.py -text -whitespace

# Exact pinned Original task source; retain upstream trailing whitespace.
scripts/rust-contracts/scanner-tasks/original/apps/epg/tasks.py -text -whitespace
# Preserve exact Original EPG test fixture EOF whitespace.
scripts/rust-contracts/channels-guide/original/apps/epg/tests/test_epg_grid_api.py -text -whitespace

# Preserve the exact pinned Original core task EOF bytes.
scripts/rust-job-contracts/scanner-logo/m3u-url-reference/pinned/core/tasks.py -text whitespace=-blank-at-eof

# Byte-exact Original test authority: six pre-existing trailing spaces.
scripts/rust-contracts/proxy-plugin/original/apps/timeshift/tests/test_views.py -whitespace
