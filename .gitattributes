# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files that should always be normalized
*.py text
*.js text
*.jsx text
*.css text
*.html text
*.md text

# Declare files that will always have specific line endings
*.bat text eol=crlf
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Preserve pinned upstream HTML whitespace and license bytes exactly.
# These are wire/provenance fixtures, not source formatting candidates.
rust/crates/store/datasets/unified-html-source-1/** -text -whitespace

# Preserve verbatim upstream license/AUTHORS underlines in attribution.
ATTRIBUTION.md conflict-marker-size=32
