+fn observer_socket(port: i32) -> Value {
+    assert!((1..=65535).contains(&port));
+    let tcp = std::fs::read_to_string("/proc/self/net/tcp").unwrap();
+    assert!(tcp.len() <= 1048576);
+    let mut matched = Vec::new();
+    for line in tcp.lines().skip(1) {
+        let fields: Vec<_> = line.split_whitespace().collect();
+        if fields.len() < 10 {
+            continue;
+        }
+        let (local_addr, local_port) = fields[1].split_once(':').unwrap();
+        let (remote_addr, remote_port) = fields[2].split_once(':').unwrap();
+        if local_addr == "0100007F"
+            && remote_addr == "0100007F"
+            && u16::from_str_radix(local_port, 16).unwrap() == port as u16
+            && u16::from_str_radix(remote_port, 16).unwrap() == 5432
+            && fields[3] == "01"
+        {
+            matched.push(fields[9].to_owned());
+        }
+    }
+    assert_eq!(matched.len(), 1, "OneActualObserverSocketTuple");
+    let link = format!("socket:[{}]", matched[0]);
+    let mut fds = Vec::new();
+    let entries: Vec<_> = std::fs::read_dir("/proc/self/fd").unwrap().collect();
+    assert!(entries.len() <= 512);
+    for row in entries {
+        let path = row.unwrap().path();
+        if std::fs::read_link(&path)
+            .ok()
+            .is_some_and(|v| v.to_string_lossy() == link)
+        {
+            let fd: i32 = path.file_name().unwrap().to_str().unwrap().parse().unwrap();
+            fds.push(fd);
+        }
+    }
+    assert!(!fds.is_empty() && fds.len() <= 4);
+    json!({"original_socket_link":link,"original_fds":fds,"native_PID":std::process::id(),"PID_namespace":std::fs::read_link("/proc/self/ns/pid").unwrap(),"network_namespace":std::fs::read_link("/proc/self/ns/net").unwrap(),"actual_local_port":port,"actual_remote_port":5432,"scope":"actual owned observer tuple+current own FDs; no global duplicate descriptor claim"})
+}
