  with tempfile.TemporaryDirectory()as d:
   root=Path(d);fixture(root);path=root/'origin/origin-requests.jsonl';rows=[json.loads(line)for line in path.read_text().splitlines()];change(rows);path.write_text(''.join(json.dumps(row)+'\n'for row in rows))
