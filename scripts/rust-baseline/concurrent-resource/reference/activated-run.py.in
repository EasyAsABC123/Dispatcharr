  phase=work.run(base,seed['path'],seed['token'],1,15,120,out/'media',start,finish,active,prefix_limit=2097152,control_check=window.check);row=phase['viewers'][0];assert row['status']==200 and not row['errors']and not row['unexpected_eof']and row['post_window_barrier']and row['prefix_bytes']==2097152 and row['measured_bytes']>=120*100000 and row['first_byte_ms']<=15000;report['playback']=phase
  def decode_saved(label,*argv,timeout):
   collection=registry.launch(compose+list(argv),limit=1048576,stdout_path=out/('decoder-'+label+'.stdout'),stderr_path=out/('decoder-'+label+'.stderr'))
   collection.wait(timeout)
   return (out/('decoder-'+label+'.stdout')).read_bytes()
  for label,file in [('startup','0.ts'),('import1','0-import1.ts'),('import2','0-import2.ts')]:
   payload=out/'media'/file;assert payload.stat().st_size==2097152;decoded=decode_saved(label,'exec','-T','baseline','ffmpeg','-hide_banner','-loglevel','error','-xerror','-progress','pipe:1','-nostats','-i','/evidence/media/'+file,'-map','0:v:0','-map','0:a:0','-t','5','-f','null','-',timeout=20);frames=max([int(l.split(b'=')[1])for l in decoded.splitlines()if l.startswith(b'frame=')],default=0);assert frames>=25;report.setdefault('decodes',[]).append({'label':label,'frames':frames,'payload_sha256':hashlib.sha256(payload.read_bytes()).hexdigest()})
  tasks=[json.loads(l)for l in(out/'workflow-prerun.jsonl').read_text().splitlines()];assert len(tasks)==6;assert all(row['reader_start_monotonic']<=t['monotonic']<=row['reader_end_monotonic']for t in tasks);done={t['id']:t for t in[json.loads(l)for l in(out/'workflow-postrun.jsonl').read_text().splitlines()]}
  for task in tasks:
   earlier=[x for x in row['byte_trace']if x['monotonic']<=task['monotonic']];later=[x for x in row['byte_trace']if x['monotonic']>=done[task['id']]['monotonic']];assert earlier and later and later[0]['bytes']>earlier[-1]['bytes']
  report['real_worker_task_overlap']=True;report['task_executions']=6;report['durable_checks']=len(json.loads((out/'source-refresh-workflow-private.json').read_text())['checks'])
  until=time.monotonic()+45
  while json.loads(execute('exec','-T','baseline','/dispatcharrpy/bin/python','-c',"import urllib.request;print(urllib.request.urlopen('http://origin:8080/stats',timeout=3).read().decode())"))['active']:
   if time.monotonic()>until:raise TimeoutError('UpstreamCleanup')
