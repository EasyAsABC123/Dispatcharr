#!/usr/bin/env python3
"""UNEXECUTED private Source-only concurrent playback/import RESOURCE DRAFT.
Original Dispatcharr and dependency authors retain application/algorithm credit.
Requires reviewed policy seal and explicit quiet cue; no accepted resource result.
"""
import argparse,hashlib,importlib.util,json,os,shutil,subprocess,sys,time,uuid,urllib.request
from pathlib import Path
HERE=Path(__file__).resolve().parent
BASE='1241b3f7ffb2e64c8d1157ecd5e3b199af1ae430'
ARCHIVE='f2323ac705be2af5d1c264f26b1d297cb2bede53874e6bceccee4bf6603fa7ff'
IMAGE='ghcr.io/dispatcharr/dispatcharr@sha256:34f9011514edd31ef0ff111b5f256d2e37614fcb08a6ee1ed9eccec9251a856f'
def load(path,name):
 spec=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);return m
def save(p,v):p.write_text(json.dumps(v,indent=2)+'\n')
RESOURCE_EXECUTION_BLOCKED=False  # Unvalidated in-flight collector/abort controls.
def main():
 if RESOURCE_EXECUTION_BLOCKED:raise RuntimeError('UnvalidatedBoundedCollectorExecutionBlocked')
 p=argparse.ArgumentParser(description=__doc__)
 p.add_argument('--repo',type=Path,required=True);p.add_argument('--output',type=Path,required=True)
 p.add_argument('--reviewed-seal',type=Path,required=True);p.add_argument('--quiet-cue',type=Path,required=True)
 p.add_argument('--repetition',type=int,choices=[1,2,3],required=True)
 args=p.parse_args();root=args.repo.resolve();out=args.output.resolve()
 # Proposed cue schema: no execution without independent parent review.
 raw=(HERE/'policy.json').read_bytes();sha=hashlib.sha256(raw).hexdigest()
 own={v.name:hashlib.sha256(v.read_bytes()).hexdigest()for v in HERE.iterdir()if v.is_file()}
 review=json.loads(args.reviewed_seal.read_text());cue=json.loads(args.quiet_cue.read_text())
 authority=load(HERE/'authorization.py','resource6_authorization')
 authority.validate(review,cue,json.loads(raw),sha,own,args.repetition,Path('/proc/sys/kernel/random/boot_id').read_text().strip(),time.time())
 if out==HERE or HERE in out.parents:raise ValueError('OutputInsideController')
 out.mkdir(parents=True,exist_ok=False);controller=out/'controller'
 shutil.copytree(HERE,controller,ignore=shutil.ignore_patterns('support','__pycache__','*.log'))
 (controller/'proc_snapshot.py').chmod(0o444)
 (out/'reviewed-seal.json').write_bytes(args.reviewed_seal.read_bytes());(out/'active-quiet-cue.json').write_bytes(args.quiet_cue.read_bytes())
 save(out/'authorization-binding.json',{'reviewed_seal_sha256':hashlib.sha256(args.reviewed_seal.read_bytes()).hexdigest(),'quiet_cue_sha256':hashlib.sha256(args.quiet_cue.read_bytes()).hexdigest(),'repetition':args.repetition,'boot_id':cue['boot_id']})
 return load(controller/'run.py','frozen_concurrent_resource').execute(root,out,controller,args.repetition)

def verify_execution_authority(out,controller,repetition):
 # Defense at the second entry too: direct execute cannot bypass fresh Root
 # authorization by avoiding main. Saved inputs are outside the controller map.
 policyraw=(controller/'policy.json').read_bytes();policy=json.loads(policyraw)
 own={p.name:hashlib.sha256(p.read_bytes()).hexdigest()for p in controller.iterdir()if p.is_file()}
 review=json.loads((out/'reviewed-seal.json').read_text());cue=json.loads((out/'active-quiet-cue.json').read_text())
 authority=load(controller/'authorization.py','full_resource_activation_authority')
 return authority.validate(review,cue,policy,hashlib.sha256(policyraw).hexdigest(),own,repetition,Path('/proc/sys/kernel/random/boot_id').read_text().strip(),time.time())

def execute(root,out,controller,repetition):
 if RESOURCE_EXECUTION_BLOCKED:raise RuntimeError('UnvalidatedBoundedCollectorExecutionBlocked')
 sys.path.insert(0,str(controller))
 from supervision import atomic_json,WorkDeadline
 report={'passed':False,'bootstrap_failed':True}
 try:
  verify_execution_authority(out,controller,repetition)
  policy=json.loads((controller/'policy.json').read_text());deadline=WorkDeadline(policy['resource_draft']['fixture_work_deadline_seconds'])
  return execute_inner(root,out,controller,repetition,report,deadline)
 except BaseException as error:
  report.update(passed=False,error_type=type(error).__name__,error_message=str(error)[:1024])
  from supervision import terminal
  terminal(report,out,[]);return 1

