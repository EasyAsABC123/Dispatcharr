  group_observer=observer.Observer(selected,tools,command=command)
  report['bootstrap_failed']=False
  report['observer_contract']=group_observer.smoke();report['observer_contract']['scope']='10s four-service capability check only; no workload resource acceptance';report['census']={}
  metadata.capture(command,selected,policy,source,controller,out,budget=budget)
  window=resource_module.Window(group_observer,selected,command,policy,out/'resource-window',corrected,registry=registry,budget=budget,deadline=deadline,final_counter_command=cleanup_counter_command);window.start()
  window.hold('idle-before-first-playback',policy['resource_draft']['idle_before_seconds'])
  window.label('playback-startup-and-warmup')
  def active(count):
   script="local k=redis.call('KEYS',ARGV[1]);local n=0;for _,v in ipairs(k)do if redis.call('TYPE',v).ok=='hash'then if redis.call('HGET',v,'user_id')~=ARGV[2]then return {-1,#k}end;n=n+1 end end;return {n,#k}"
   data=json.loads(execute('exec','-T','baseline','redis-cli','--json','EVAL',script,'0','live:channel:'+seed['channel_uuid']+':clients:*',str(seed['user_id'])));assert data==[count,count];slots=int(execute('exec','-T','baseline','redis-cli','GET','profile_connections:'+str(seed['profile_id'])).strip()or b'0');assert slots==count;return{'clients':count,'all_owned_user_id':True}
  def footprint(label):
   # Actual channel/slot retention stays visible; no expired-key sweep/reset.
   script="import json,redis;from pathlib import Path;s=json.loads(Path('/evidence/concurrent-seed-private.json').read_text());r=redis.Redis(host='baseline',password='playback-fixture-only');keys=[];cursor=0\nwhile True:\n cursor,part=r.scan(cursor,match='live:channel:'+s['channel_uuid']+'*',count=64);keys.extend(part)\n if len(keys)>1024:raise RuntimeError('RetentionKeyBound')\n if cursor==0:break\nprint(json.dumps({'keys':[{'key':k.decode(),'type':r.type(k).decode(),'ttl':r.ttl(k),'memory_bytes':r.memory_usage(k)}for k in sorted(set(keys))],'profile_slots':int(r.get('profile_connections:'+str(s['profile_id']))or 0)}))"
   value=json.loads(execute('exec','-T','baseline','/dispatcharrpy/bin/python','-c',script))
   value['origin']=json.loads(execute('exec','-T','baseline','/dispatcharrpy/bin/python','-c',"import urllib.request;print(urllib.request.urlopen('http://origin:8080/stats',timeout=3).read().decode())"))
   value.update(monotonic=time.monotonic(),phase=label)
   save(out/('footprint-'+label+'-private.json'),value)
   if value['profile_slots']!=0 or value['origin']['active']!=0:raise ValueError('PostCloseNotSettled')
  def start():
   nonlocal job,joblog
   window.begin_workload()
   save(out/'concurrent-window.json',{'begin':time.monotonic()});argv=compose+['exec','-T','-e','POSTGRES_DB='+database,'-e','JOB_DISPOSABLE_FIXTURE=playback-fixture-only','-e','CELERY_BROKER_URL=redis://:playback-fixture-only@localhost:6379/8','-e','CELERY_RESULT_BACKEND=redis://:playback-fixture-only@localhost:6379/9','baseline','/dispatcharrpy/bin/python','/concurrent/source_workflow.py'];job=registry.launch(argv,stdout_path=out/'workflow-controller-private.stdout',stderr_path=out/'workflow-controller-private.stderr');return None
  def finish(_state,begin,end):
