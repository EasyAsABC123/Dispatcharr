+#[derive(Debug)]
+pub struct RecurringRow {
+    pub id: i64,
+    pub channel_id: i64,
+    pub name: Option<String>,
+    pub days: Option<Value>,
+    pub start: chrono::NaiveTime,
+    pub end: chrono::NaiveTime,
+    pub start_date: Option<chrono::NaiveDate>,
+    pub end_date: Option<chrono::NaiveDate>,
+}
+/// Source maintain_recurring selects only enabled rules. An empty snapshot is
+/// normal integer0, including the case where disabled rows/old schedules exist.
+/// This first domain refuses >1 enabled row; it never processes just row1 of an
+/// unsupported multi-rule configuration. No row data is changed during admission.
+pub async fn recurring_snapshot(
+    pool: PgPool,
+    owner: Arc<dyn Send + Sync>,
+) -> Result<Option<RecurringRow>, SnapshotError> {
+    tokio::spawn(async move {
+        let _owner=owner;
+        let mut connection=pool.acquire().await.map_err(|e|SnapshotError::Physical(error(Stage::Acquire,e,None)))?;
+        let observed=async {
+            admit_schema(&mut connection).await?;
+            type Row=(i64,i64,Option<String>,Option<Value>,chrono::NaiveTime,chrono::NaiveTime,Option<chrono::NaiveDate>,Option<chrono::NaiveDate>,bool);
+            let rows:Vec<Row>=sqlx::query_as("SELECT id::bigint,channel_id::bigint,CASE WHEN octet_length(name)<=255 THEN name ELSE NULL END,CASE WHEN octet_length(days_of_week::text)<=128 THEN days_of_week ELSE NULL END,start_time,end_time,start_date,end_date,(octet_length(name)<=255 AND octet_length(days_of_week::text)<=128) FROM dispatcharr_channels_recurringrecordingrule WHERE enabled ORDER BY channel_id,start_time LIMIT 2")
+                .fetch_all(&mut *connection).await.map_err(|e|SnapshotError::Physical(error(Stage::SnapshotRecurring,e,None)))?;
+            if rows.len()>1 {return Err(SnapshotError::Unsupported("multiple enabled recurring rules"));}
+            let Some((id,channel_id,name,days,start,end,start_date,end_date,supported))=rows.into_iter().next() else {return Ok(None);};
+            if !supported {return Err(SnapshotError::Unsupported("recurring text snapshot bound"));}
+            Ok(Some(RecurringRow{id,channel_id,name,days,start,end,start_date,end_date}))
+        }.await;
+        let ready=connection.ping().await;
+        let closed=connection.close().await;
+        match observed {
+            Err(SnapshotError::Physical(mut e))=>{e.settlement_error=ready.err().or_else(||closed.err());Err(SnapshotError::Physical(e))},
+            other=>{ready.map_err(|e|SnapshotError::Physical(error(Stage::Ready,e,None)))?;closed.map_err(|e|SnapshotError::Physical(error(Stage::Close,e,None)))?;other}
+        }
+    }).await.map_err(|_|SnapshotError::Supervisor)?
+}
