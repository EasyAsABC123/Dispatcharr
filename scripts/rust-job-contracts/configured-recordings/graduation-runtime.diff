+#[cfg(test)]
+mod caught_insert_tests {
+    use super::*;
+    fn fields() -> InsertErrorFields<'static> {
+        InsertErrorFields {
+            severity: sqlx::postgres::PgSeverity::Error,
+            code: "P0001",
+            message: "owned configured recording failure",
+            context: Some("PL/pgSQL function rust_owned_recording_fail() line 1 at RAISE"),
+            extra_diagnostics: false,
+        }
+    }
+    #[test]
+    fn only_settled_observed_insert_context_has_normal_data_authority() {
+        assert_eq!(observed_insert_failure(Stage::InsertRecording,None,true,fields()).unwrap().message(),
+            "owned configured recording failure\nCONTEXT:  PL/pgSQL function rust_owned_recording_fail() line 1 at RAISE");
+        for stage in [
+            Stage::Acquire,
+            Stage::Dedup,
+            Stage::SnapshotProgrammes,
+            Stage::ClockedInsert,
+            Stage::PeriodicInsert,
+            Stage::AssignTask,
+            Stage::Ready,
+            Stage::Close,
+        ] {
+            assert!(observed_insert_failure(stage, None, true, fields()).is_none());
+        }
+        assert!(observed_insert_failure(Stage::InsertRecording, Some(1), true, fields()).is_none());
+        assert!(observed_insert_failure(Stage::InsertRecording, None, false, fields()).is_none());
+    }
+    #[test]
+    fn no_general_error_or_uncertain_diagnostic_projection() {
+        let mut wrong = fields();
+        wrong.code = "23505";
+        assert!(observed_insert_failure(Stage::InsertRecording, None, true, wrong).is_none());
+        let mut wrong = fields();
+        wrong.message = "different server error";
+        assert!(observed_insert_failure(Stage::InsertRecording, None, true, wrong).is_none());
+        let mut wrong = fields();
+        wrong.context = None;
+        assert!(observed_insert_failure(Stage::InsertRecording, None, true, wrong).is_none());
+        let mut wrong = fields();
+        wrong.extra_diagnostics = true;
+        assert!(observed_insert_failure(Stage::InsertRecording, None, true, wrong).is_none());
+        let mut wrong = fields();
+        wrong.severity = sqlx::postgres::PgSeverity::Fatal;
+        assert!(observed_insert_failure(Stage::InsertRecording, None, true, wrong).is_none());
+        let io = Error {
+            stage: Stage::InsertRecording,
+            source: sqlx::Error::Io(std::io::Error::other("owned IO ambiguity")),
+            committed_recording: None,
+            settlement_error: None,
+        };
+        assert!(io.known_source_insert_failure().is_none());
+    }
