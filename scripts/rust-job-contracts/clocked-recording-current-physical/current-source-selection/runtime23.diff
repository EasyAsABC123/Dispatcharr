+            || context.4 < 0
+            || context.4 as u64 >= max_events
+        {
+            return Err(Error::Unsupported(
+                "audit context changed/nontrimming scope",
+            ));
+        }
+        let event_type = match kind {
+            NormalEvent::Started => "recording_start",
+            NormalEvent::Ended => "recording_end",
+        };
