+            return if requested {
+                Err(Error::CallerShutdown(Box::new(receipt)))
+            } else {
+                Err(Error::UnexpectedExit(Box::new(receipt)))
+            };
+        }
+        thread::sleep(Duration::from_millis(25));
+    }
