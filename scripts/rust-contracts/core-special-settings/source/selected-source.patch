+            .is_err());
+        drop(reader);
+        assert_eq!(effects.retained_cache_entries(), 1);
+        drop(cloned);
+        assert_eq!(effects.retained_cache_entries(), 0);
+        assert_eq!(permits.available_permits(), 4);
+    }
