+    #[test]
+    fn renamed_group_dispatches_old_serializer_and_new_signal() {
+        for group in [
+            "system_settings",
+            "network_access",
+            "reverse_proxy_auth",
+            "proxy_settings",
+            "stream_settings",
+            "dvr_settings",
+        ] {
