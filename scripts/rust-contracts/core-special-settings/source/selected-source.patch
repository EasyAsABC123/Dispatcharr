+    root_id: &'a str,
+    parent_id: Option<()>,
+    ignore_result: bool,
+}
+#[derive(Serialize)]
+struct Properties<'a> {
+    correlation_id: &'a str,
+    reply_to: &'a str,
+    delivery_mode: u8,
+    delivery_info: Delivery,
+    priority: u8,
+    body_encoding: &'static str,
+    delivery_tag: &'a str,
+}
+#[derive(Serialize)]
+struct Delivery {
+    exchange: &'static str,
+    routing_key: &'static str,
