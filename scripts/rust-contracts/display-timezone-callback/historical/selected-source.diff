+#[derive(Default, serde::Serialize)]
+struct HttpFate {
+    accepted: usize,
+    handler_started: usize,
+    handler_cancelled: usize,
+    response_statuses: Vec<u16>,
+    bytes_read: usize,
+    bytes_written: usize,
+    read_eof: bool,
+    write_errors: Vec<String>,
+    socket_dropped: bool,
+    capacity_exceeded: bool,
