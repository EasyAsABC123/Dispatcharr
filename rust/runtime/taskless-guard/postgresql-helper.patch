diff --git a/src/bin/pg_dump/dispatcharr_guarded_restore.h b/src/bin/pg_dump/dispatcharr_guarded_restore.h
new file mode 100644
--- /dev/null
+++ b/src/bin/pg_dump/dispatcharr_guarded_restore.h
@@ -0,0 +1,232 @@
+/*
+ * Private Dispatcharr direct-restore guard prototype for PostgreSQL 17.11.
+ * PostgreSQL Global Development Group, Regents of the University of
+ * California, and original Dispatcharr contributors retain full credit.
+ * Distributed under the PostgreSQL terms in COPYRIGHT.
+ */
+#ifndef DISPATCHARR_GUARDED_RESTORE_H
+#define DISPATCHARR_GUARDED_RESTORE_H
+
+#include <poll.h>
+#include <sys/socket.h>
+
+#include "libpq-fe.h"
+#include "portability/instr_time.h"
+
+#define DISPATCHARR_GUARD_TIMEOUT_MS 30000
+
+typedef struct DispatcharrRestoreGuard
+{
+	int			control_fd;
+	char		database[NAMEDATALEN];
+	char		database_oid[11];
+	char		postmaster_us[20];
+	char		fence_pid[11];
+	char		fence_us[20];
+	char		apply_pid[11];
+	char		apply_us[20];
+	char		xid[21];
+} DispatcharrRestoreGuard;
+
+static uint64
+dispatcharr_milliseconds(void)
+{
+	instr_time	now;
+
+	INSTR_TIME_SET_CURRENT(now);
+	return (uint64) INSTR_TIME_GET_MILLISEC(now);
+}
+
+static void
+dispatcharr_wait(int control_fd, short events, uint64 deadline)
+{
+	struct pollfd fd = {control_fd, events, 0};
+
+	for (;;)
+	{
+		uint64		now = dispatcharr_milliseconds();
+		int			available;
+
+		if (now >= deadline)
+			pg_fatal("guarded restore owner deadline expired");
+		available = poll(&fd, 1, (int) (deadline - now));
+		if (available > 0 && (fd.revents & events))
+			return;
+		if (available < 0 && errno == EINTR)
+			continue;
+		pg_fatal("guarded restore owner unavailable");
+	}
+}
+
+static void
+dispatcharr_read_line(int control_fd, char *line, size_t capacity, uint64 deadline)
+{
+	size_t		length = 0;
+
+	for (;;)
+	{
+		unsigned char c;
+		ssize_t		count;
+
+		dispatcharr_wait(control_fd, POLLIN, deadline);
+		count = recv(control_fd, &c, 1, MSG_DONTWAIT);
+		if (count < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK))
+			continue;
+		if (count != 1)
+			pg_fatal("guarded restore owner frame unavailable");
+		if (c == '\n')
+		{
+			line[length] = '\0';
+			return;
+		}
+		if (c < 32 || c == 127)
+			pg_fatal("invalid guarded restore owner frame");
+		if (length + 1 == capacity)
+			pg_fatal("guarded restore owner frame exceeds limit");
+		line[length++] = (char) c;
+	}
+}
+
+static void
+dispatcharr_send(int control_fd, const char *message, uint64 deadline)
+{
+	size_t		left = strlen(message);
+
+	while (left > 0)
+	{
+		ssize_t		count;
+
+		dispatcharr_wait(control_fd, POLLOUT, deadline);
+		count = send(control_fd, message, left,
+					 MSG_DONTWAIT | MSG_NOSIGNAL);
+		if (count < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK))
+			continue;
+		if (count <= 0)
+			pg_fatal("guarded restore owner reply unavailable");
+		message += count;
+		left -= count;
+	}
+}
+
+static void
+dispatcharr_read_guard(DispatcharrRestoreGuard *guard, int control_fd)
+{
+	const uint64 deadline = dispatcharr_milliseconds() + DISPATCHARR_GUARD_TIMEOUT_MS;
+	char		version[5];
+	struct sockaddr_storage peer;
+	socklen_t	peer_length = sizeof(peer);
+
+	guard->control_fd = control_fd;
+	if (getpeername(control_fd, (struct sockaddr *) &peer,
+					&peer_length) != 0 || peer.ss_family != AF_UNIX)
+		pg_fatal("guarded restore requires a private owner socket");
+	dispatcharr_read_line(control_fd, version, sizeof(version), deadline);
+	if (strcmp(version, "DPR1") != 0)
+		pg_fatal("unsupported guarded restore owner protocol");
+	dispatcharr_read_line(control_fd, guard->database, sizeof(guard->database), deadline);
+	dispatcharr_read_line(control_fd, guard->database_oid, sizeof(guard->database_oid), deadline);
+	dispatcharr_read_line(control_fd, guard->postmaster_us, sizeof(guard->postmaster_us), deadline);
+	dispatcharr_read_line(control_fd, guard->fence_pid, sizeof(guard->fence_pid), deadline);
+	dispatcharr_read_line(control_fd, guard->fence_us, sizeof(guard->fence_us), deadline);
+	if (guard->database[0] == '\0')
+		pg_fatal("guarded restore expected database is empty");
+}
+
+static void
+dispatcharr_barrier(const DispatcharrRestoreGuard *guard, const char *notification, const char *grant)
+{
+	const uint64 deadline = dispatcharr_milliseconds() + DISPATCHARR_GUARD_TIMEOUT_MS;
+	char		ack[16];
+
+	dispatcharr_send(guard->control_fd, notification, deadline);
+	dispatcharr_read_line(guard->control_fd, ack, sizeof(ack), deadline);
+	if (strcmp(ack, grant) != 0)
+		pg_fatal("guarded restore owner grant unavailable");
+}
+
+static void
+dispatcharr_copy_identity(char *destination, size_t size, const char *value)
+{
+	if (value[0] == '\0' || strlen(value) >= size)
+		pg_fatal("guarded restore effect identity unavailable");
+	strlcpy(destination, value, size);
+}
+
+static void
+dispatcharr_verify_generation(PGconn *connection, DispatcharrRestoreGuard *guard)
+{
+	const char *values[] = {
+		guard->database, guard->database_oid, guard->postmaster_us,
+		guard->fence_pid, guard->fence_us
+	};
+	PGresult   *result;
+	const char *pid;
+	const char *started;
+	const char *xid;
+
+	if (PQtransactionStatus(connection) != PQTRANS_INTRANS)
+		pg_fatal("guarded restore transaction unavailable");
+	result = PQexec(connection, "SELECT pg_catalog.pg_stat_clear_snapshot()");
+	if (PQresultStatus(result) != PGRES_TUPLES_OK)
+		pg_fatal("guarded restore activity snapshot unavailable");
+	PQclear(result);
+	result = PQexecParams(connection,
+						  "SELECT own.pid::text, "
+						  "(extract(epoch FROM own.backend_start)*1000000)::bigint::text, "
+						  "pg_catalog.pg_current_xact_id()::text "
+						  "FROM pg_catalog.pg_stat_activity AS own "
+						  "JOIN pg_catalog.pg_stat_activity AS held "
+						  "ON held.datid=own.datid AND held.usesysid=own.usesysid "
+						  "WHERE own.pid=pg_catalog.pg_backend_pid() "
+						  "AND held.pid<>own.pid AND held.pid=$4::integer "
+						  "AND own.datname=$1 AND own.datid::bigint=$2::bigint "
+						  "AND (extract(epoch FROM pg_catalog.pg_postmaster_start_time())"
+						  "*1000000)::bigint=$3::bigint "
+						  "AND (extract(epoch FROM held.backend_start)*1000000)::bigint=$5::bigint",
+						  lengthof(values), NULL, values, NULL, NULL, 0);
+	if (PQresultStatus(result) != PGRES_TUPLES_OK || PQntuples(result) != 1 ||
+		PQnfields(result) != 3 || PQgetisnull(result, 0, 0) ||
+		PQgetisnull(result, 0, 1) || PQgetisnull(result, 0, 2))
+		pg_fatal("guarded restore target generation unavailable");
+	pid = PQgetvalue(result, 0, 0);
+	started = PQgetvalue(result, 0, 1);
+	xid = PQgetvalue(result, 0, 2);
+	if (guard->apply_pid[0] == '\0')
+	{
+		dispatcharr_copy_identity(guard->apply_pid, sizeof(guard->apply_pid), pid);
+		dispatcharr_copy_identity(guard->apply_us, sizeof(guard->apply_us), started);
+		dispatcharr_copy_identity(guard->xid, sizeof(guard->xid), xid);
+	}
+	else if (strcmp(guard->apply_pid, pid) != 0 ||
+			 strcmp(guard->apply_us, started) != 0 || strcmp(guard->xid, xid) != 0)
+		pg_fatal("guarded restore effect connection or transaction changed");
+	PQclear(result);
+}
+
+static void
+dispatcharr_reset_schema(PGconn *connection)
+{
+	PGresult   *result;
+
+	result = PQexec(connection, "DROP SCHEMA IF EXISTS public CASCADE; "
+					"CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO public;");
+	if (PQresultStatus(result) != PGRES_COMMAND_OK ||
+		PQtransactionStatus(connection) != PQTRANS_INTRANS)
+		pg_fatal("guarded restore schema reset failed");
+	PQclear(result);
+}
+
+static void
+dispatcharr_commit(PGconn *connection, const DispatcharrRestoreGuard *guard)
+{
+	PGresult   *result = PQexec(connection, "COMMIT");
+
+	if (PQresultStatus(result) != PGRES_COMMAND_OK ||
+		strcmp(PQcmdStatus(result), "COMMIT") != 0 ||
+		PQtransactionStatus(connection) != PQTRANS_IDLE)
+		pg_fatal("guarded restore commit unsettled");
+	PQclear(result);
+	dispatcharr_send(guard->control_fd, "DONE\n", dispatcharr_milliseconds() + DISPATCHARR_GUARD_TIMEOUT_MS);
+}
+
+#endif
