    "                      <div class=\"tab-pane\" id=\"put-object-form\">\n",
    "                        <form action=\"@@GUIDE_OWNED_DETAIL_PATH@@?format=api\" data-method=\"PUT\" enctype=\"multipart/form-data\" class=\"form-horizontal\" novalidate>\n",
