    "            \n",
    "          </ul>\n",
    "        \n",
    "\n",
    "        <!-- Content -->\n",
    "        <div id=\"content\" role=\"main\" aria-label=\"content\">\n",
    "          \n",
    "\n",
    "          <div class=\"region\"  aria-label=\"request form\">\n",
    "          \n",
    "\n",
    "          \n",
    "            <form id=\"get-form\" class=\"pull-right\">\n",
    "              <fieldset>\n",
    "                \n",
    "                  <div class=\"btn-group format-selection\">\n",
    "                    <a class=\"btn btn-primary js-tooltip\" href=\"@@GUIDE_OWNED_DETAIL_PATH@@?format=api\" rel=\"nofollow\" title=\"Make a GET request on the Program Instance resource\">GET</a>\n",
    "\n",
    "                    <button class=\"btn btn-primary dropdown-toggle js-tooltip\" data-toggle=\"dropdown\" title=\"Specify a format for the GET request\">\n",
    "                      <span class=\"caret\"></span>\n",
    "                    </button>\n",
    "                    <ul class=\"dropdown-menu\">\n",
    "                      \n",
    "                        <li>\n",
    "                          <a class=\"js-tooltip format-option\" href=\"@@GUIDE_OWNED_DETAIL_PATH@@?format=json\" rel=\"nofollow\" title=\"Make a GET request on the Program Instance resource with the format set to `json`\">json</a>\n",
    "                        </li>\n",
    "                      \n",
    "                        <li>\n",
    "                          <a class=\"js-tooltip format-option\" href=\"@@GUIDE_OWNED_DETAIL_PATH@@?format=api\" rel=\"nofollow\" title=\"Make a GET request on the Program Instance resource with the format set to `api`\">api</a>\n",
    "                        </li>\n",
    "                      \n",
    "                    </ul>\n",
    "                  </div>\n",
    "                \n",
    "              </fieldset>\n",
    "            </form>\n",
    "          \n",
    "\n",
    "          \n",
    "            <form class=\"button-form\" action=\"@@GUIDE_OWNED_DETAIL_PATH@@?format=api\" data-method=\"OPTIONS\">\n",
    "              <button class=\"btn btn-primary js-tooltip\" title=\"Make an OPTIONS request on the Program Instance resource\">OPTIONS</button>\n",
    "            </form>\n",
    "          \n",
    "\n",
    "          \n",
    "            <button class=\"btn btn-danger button-form js-tooltip\" title=\"Make a DELETE request on the Program Instance resource\" data-toggle=\"modal\" data-target=\"#deleteModal\">DELETE</button>\n",
    "\n",
    "            <!-- Delete Modal -->\n",
    "            <div class=\"modal fade\" id=\"deleteModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\n",
    "              <div class=\"modal-dialog\">\n",
    "                <div class=\"modal-content\">\n",
    "                  <div class=\"modal-body\">\n",
    "                    <h4 class=\"text-center\">Are you sure you want to delete this Program Instance?</h4>\n",
    "                  </div>\n",
    "                  <div class=\"modal-footer\">\n",
    "                    <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Cancel</button>\n",
    "                    <form class=\"button-form\" action=\"@@GUIDE_OWNED_DETAIL_PATH@@?format=api\" data-method=\"DELETE\">\n",
    "                      <button class=\"btn btn-danger\">Delete</button>\n",
    "                    </form>\n",
    "                  </div>\n",
    "                </div>\n",
    "              </div>\n",
    "            </div>\n",
    "          \n",
    "\n",
    "          \n",
    "            <div class=\"dropdown\" style=\"float: right; margin-right: 10px\">\n",
    "              <button class=\"btn btn-default\" id=\"extra-actions-menu\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"true\">\n",
    "                Extra Actions\n",
    "                <span class=\"caret\"></span>\n",
    "              </button>\n",
    "              <ul class=\"dropdown-menu\" aria-labelledby=\"extra-actions-menu\">\n",
    "                \n",
