{
  "agent": {
    "name": "User Agent List",
    "description": "API endpoint that allows user agents to be viewed, created, edited, or deleted.",
    "renders": [
      "application/json",
      "text/html"
    ],
    "parses": [
      "application/json",
      "application/x-www-form-urlencoded",
      "multipart/form-data"
    ],
    "actions": {
      "POST": {
        "id": {
          "type": "integer",
          "required": false,
          "read_only": true,
          "label": "ID"
        },
        "name": {
          "type": "string",
          "required": true,
          "read_only": false,
          "label": "Name",
          "help_text": "The User-Agent name.",
          "max_length": 512
        },
        "user_agent": {
          "type": "string",
          "required": true,
          "read_only": false,
          "label": "User agent",
          "help_text": "The complete User-Agent string sent by the client.",
          "max_length": 512
        },
        "description": {
          "type": "string",
          "required": false,
          "read_only": false,
          "label": "Description",
          "help_text": "An optional description of the client or device type.",
          "max_length": 255
        },
        "is_active": {
          "type": "boolean",
          "required": false,
          "read_only": false,
          "label": "Is active",
          "help_text": "Whether this user agent is currently allowed/recognized."
        },
        "created_at": {
          "type": "datetime",
          "required": false,
          "read_only": true,
          "label": "Created at"
        },
        "updated_at": {
          "type": "datetime",
          "required": false,
          "read_only": true,
          "label": "Updated at"
        }
      }
    }
  },
  "profile": {
    "name": "Stream Profile List",
    "description": "API endpoint that allows stream profiles to be viewed, created, edited, or deleted.",
    "renders": [
      "application/json",
      "text/html"
    ],
    "parses": [
      "application/json",
      "application/x-www-form-urlencoded",
      "multipart/form-data"
    ],
    "actions": {
      "POST": {
        "id": {
          "type": "integer",
          "required": false,
          "read_only": true,
          "label": "ID"
        },
        "name": {
          "type": "string",
          "required": true,
          "read_only": false,
          "label": "Name",
          "help_text": "Name of the stream profile",
          "max_length": 255
        },
        "command": {
          "type": "string",
          "required": false,
          "read_only": false,
          "label": "Command",
          "help_text": "Command to execute (e.g., 'yt.sh', 'streamlink', or 'vlc')",
          "max_length": 255
        },
        "parameters": {
          "type": "string",
          "required": false,
          "read_only": false,
          "label": "Parameters",
          "help_text": "Command-line parameters. Use {userAgent}, {streamUrl}, and {channelId} as placeholders."
        },
        "is_active": {
          "type": "boolean",
          "required": false,
          "read_only": false,
          "label": "Is active",
          "help_text": "Whether this profile is active"
        },
        "user_agent": {
          "type": "field",
          "required": false,
          "read_only": false,
          "label": "User agent",
          "help_text": "Optional user agent to use. If not set, you can fall back to a default."
        },
        "locked": {
          "type": "boolean",
          "required": false,
          "read_only": false,
          "label": "Locked",
          "help_text": "Protected - can't be deleted or modified"
        }
      }
    }
  }
}
